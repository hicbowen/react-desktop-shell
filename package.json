{
  "name": "react-desktop-shell",
  "version": "0.22.1",
  "type": "module",
  "description": "A lightweight native-like desktop app shell for building React desktop applications.",
  "license": "MIT",
  "author": "hicbowen",
  "keywords": [
    "react",
    "desktop",
    "app-shell",
    "titlebar",
    "navigation",
    "sidebar",
    "wails",
    "electron",
    "tauri",
    "fluent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hicbowen/react-desktop-shell.git"
  },
  "homepage": "https://github.com/hicbowen/react-desktop-shell#readme",
  "bugs": {
    "url": "https://github.com/hicbowen/react-desktop-shell/issues"
  },
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "import": "./dist/ai/index.js"
    },
    "./ai/style.css": "./dist/ai/style.css",
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./core/style.css": "./dist/core/style.css",
    "./data": {
      "types": "./dist/data/index.d.ts",
      "import": "./dist/data/index.js"
    },
    "./data/style.css": "./dist/data/style.css",
    "./feedback": {
      "types": "./dist/feedback/index.d.ts",
      "import": "./dist/feedback/index.js"
    },
    "./feedback/style.css": "./dist/feedback/style.css",
    "./forms": {
      "types": "./dist/forms/index.d.ts",
      "import": "./dist/forms/index.js"
    },
    "./forms/style.css": "./dist/forms/style.css",
    "./navigation": {
      "types": "./dist/navigation/index.d.ts",
      "import": "./dist/navigation/index.js"
    },
    "./navigation/style.css": "./dist/navigation/style.css",
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\"",
    "dev": "vite --config vite.example.config.ts",
    "build:example": "vite build --config vite.example.config.ts",
    "build": "npm run clean && vite build && node scripts/build-domain-styles.mjs && tsc -p tsconfig.build.json",
    "format": "prettier --write .prettierrc.json README.md CHANGELOG.md docs/migration.md docs/releasing.md package.json scripts/*.mjs",
    "format:check": "prettier --check .prettierrc.json README.md CHANGELOG.md docs/migration.md docs/releasing.md package.json scripts/*.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "check:package": "node scripts/check-package.mjs",
    "verify": "npm run format:check && npm run lint && npm run test && npm run build && npm run check:package",
    "verify:publish": "npm run format:check && npm run lint && npm run build && npm run check:package",
    "prepack": "npm run verify:publish",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "@tanstack/react-table": ">=8.21.0 <9.0.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-table": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@fluentui/react-icons": "^2.0.335",
    "@tanstack/react-table": "^8.21.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.0.14",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.6",
    "@shikijs/engine-javascript": "^4.3.1",
    "@shikijs/langs": "^4.3.1",
    "@shikijs/themes": "^4.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.3.1"
  }
}
